<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="start|center_vertical"
    android:background="@drawable/widget_clock_background"
    android:padding="16dp">
    <TextClock android:id="@+id/widget_digital_clock"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm"
        android:textSize="40sp" android:textStyle="bold"
        android:textColor="#ffffff" android:shadowColor="#dd000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
    <TextView android:id="@+id/widget_date"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Monday, 9 November"
        android:textSize="13sp" android:textStyle="bold"
        android:textColor="#ffffff" android:shadowColor="#dd000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
    <TextView android:id="@+id/widget_weather"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="Current location · 24° · Clear"
        android:textSize="13sp"
        android:textColor="#ffffff" android:shadowColor="#dd000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
    <TextView android:id="@+id/widget_highlow"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="High 26° · Low 18°"
        android:textSize="12sp"
        android:textColor="#ffffff" android:shadowColor="#dd000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView android:id="@+id/widget_feels"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Feels like 26°" android:textSize="12sp"
            android:textColor="#ffffff" android:shadowColor="#dd000000"
            android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
        <TextView android:id="@+id/widget_wind"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Wind 12 km/h NW" android:textSize="12sp"
            android:textColor="#ffffff" android:shadowColor="#dd000000"
            android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="2dp">
        <ImageView android:id="@+id/widget_sun_icon"
            android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_sunrise"/>
        <TextView android:id="@+id/widget_sun"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="4dp" android:text="Sunset 5:20 PM"
            android:textSize="12sp"
            android:textColor="#ffffff" android:shadowColor="#dd000000"
            android:shadowDx="0" android:shadowDy="2" android:shadowRadius="5"/>
    </LinearLayout>
</LinearLayout>
