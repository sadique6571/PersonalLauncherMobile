<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="4dp">
    <AnalogClock android:id="@+id/widget_mechanical_face"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:dial="@drawable/widget_mechanical_dial_tile"
        android:hand_hour="@drawable/widget_mechanical_hand_hour"
        android:hand_minute="@drawable/widget_mechanical_hand_minute"
        android:hand_second="@drawable/widget_mechanical_hand_second"
        android:contentDescription="@string/widget_mechanical_clock_description"/>
</FrameLayout>
